{
  "name": "adramelech",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "doppler run -- turbo run build",
    "dev": "doppler run -- turbo run dev",
    "lint": "doppler run -- turbo run lint",
    "format": "doppler run -- turbo run format",
    "type-check": "doppler run -- turbo run type-check",
